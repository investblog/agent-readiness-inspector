{
  "name": "agent-readiness-inspector",
  "version": "0.1.0",
  "description": "Audit any site for AI-agent readiness — right in your browser, including pages behind login.",
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build:brand-icons": "tsx scripts/build-brand-icons.mts",
    "calibrate": "tsx scripts/calibrate.mts",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome check src/ scripts/ wxt.config.ts",
    "lint:fix": "biome check --write src/ scripts/ wxt.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && biome check src/ scripts/ wxt.config.ts && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@mdi/svg": "^7.4.47",
    "playwright": "^1.62.1",
    "svgo": "^4.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "wxt": "^0.19.0"
  }
}
